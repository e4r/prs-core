{
  "name": "@e4r/prs-core",
  "version": "0.1.0",
  "description": "Phase Ratio Synthesis — core library for frequency-native microtonal composition",
  "license": "AGPL-3.0-only",
  "author": "Leonardo Maria Miliacca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e4r/prs-core.git"
  },
  "bugs": {
    "url": "https://github.com/e4r/prs-core/issues"
  },
  "homepage": "https://github.com/e4r/prs-core#readme",
  "keywords": [
    "music",
    "microtonal",
    "tuning",
    "just-intonation",
    "psychoacoustics",
    "plomp-levelt",
    "phase-ratio-synthesis"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CITATION.cff"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint --strict && attw --pack . --profile node16",
    "smoke": "node scripts/smoke.mjs && node scripts/smoke.cjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run check:package && npm run smoke",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
